<div class="section-card card-lavanda p-8 m-4 md:m-8 flex flex-col items-center justify-center">
  <h2 id="countdownTitle" class="text-[23px] text-gold bodoni-moda italic tracking-wider text-center">Cuánto falta para la graduación</h2>
  <div id="countdownUnits" class="flex md:gap-12 gap-4 mt-6 text-gold bodoni-moda">
    <div class="flex flex-col items-center">
      <span id="days" class="text-[40px] md:text-[47px] font-normal">0</span>
      <span class="text-[15px] md:text-[20px] mt-2 text-primary">Días</span>
    </div>
    <div class="flex flex-col items-center">
      <span id="hours" class="text-[40px] md:text-[47px] font-normal">0</span>
      <span class="text-[15px] md:text-[20px] mt-2 text-primary">Horas</span>
    </div>
    <div class="flex flex-col items-center">
      <span id="minutes" class="text-[40px] md:text-[47px] font-normal">0</span>
      <span class="text-[15px] md:text-[20px] mt-2 text-primary">Minutos</span>
    </div>
    <div class="flex flex-col items-center">
      <span id="seconds" class="text-[40px] md:text-[47px] font-normal">0</span>
      <span class="text-[15px] md:text-[20px] mt-2 text-primary">Segundos</span>
    </div>
  </div>
</div>

<script>
  const eventDate = new Date('2026-12-13T14:45:00').getTime();
  const DAY = 1000 * 60 * 60 * 24;

  function updateCountdown() {
    const diff = eventDate - Date.now();

    if (diff <= 0) {
      const title = document.getElementById('countdownTitle');
      const units = document.getElementById('countdownUnits');
      if (title) {
        title.textContent = -diff < DAY ? '¡Hoy es el gran día!' : 'Gracias por acompañarnos';
        title.classList.add('text-[32px]');
      }
      units?.classList.add('hidden');
      clearInterval(timer);
      return;
    }

    const days = Math.floor(diff / DAY);
    const hours = Math.floor((diff % DAY) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    document.getElementById('days')!.textContent = days.toString();
    document.getElementById('hours')!.textContent = hours.toString();
    document.getElementById('minutes')!.textContent = minutes.toString();
    document.getElementById('seconds')!.textContent = seconds.toString();
  }

  const timer = setInterval(updateCountdown, 1000);
  updateCountdown();
</script>
